---
import Icon from './Icon.astro'
import { useCopy, type Lang } from '../i18n'
import { REPO_URL } from '../config'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = useCopy(lang)
---

<section class="section ext">
  <div class="wrap cols">
    <div class="text">
      <p class="eyebrow">{c.extension.label}</p>
      <h2>{c.extension.title}</h2>
      <p class="lede">{c.extension.body}</p>
      <a class="link-quiet cta" href={REPO_URL} rel="noopener">
        {c.extension.cta}
        <Icon name="arrowRight" size={16} />
      </a>
    </div>

    <div class="mock" aria-hidden="true">
      <div class="page">
        <div class="row w-60"></div>
        <div class="row w-90"></div>
        <div class="pick">
          <span class="tag">section.pricing</span>
          <div class="row w-70"></div>
          <div class="row w-45"></div>
        </div>
        <div class="row w-80"></div>
        <div class="row w-35"></div>
      </div>
      <div class="side">
        <span class="side-head">claude</span>
        <p class="side-line">https://example.com/pricing</p>
        <p class="side-line">section.pricing</p>
        <p class="side-line typed">why is this column wider than the others?<span class="caret"></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .ext {
    border-top: 0;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
  }

  h2 {
    margin-top: 14px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem);
    max-width: calc(16ch * var(--measure-scale));
  }

  .lede {
    margin-top: 20px;
    max-width: calc(52ch * var(--measure-scale));
    font-size: 15.5px;
  }

  .cta {
    margin-top: 24px;
  }

  .mock {
    display: flex;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.9);
    transform: translateY(8px);
  }

  .page {
    flex: 1 1 auto;
    min-width: 0;
    padding: 22px 20px;
    background: var(--bg-raised);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .row {
    height: 9px;
    border-radius: 3px;
    background: var(--line);
  }

  .w-35 {
    width: 35%;
  }
  .w-45 {
    width: 45%;
  }
  .w-60 {
    width: 60%;
  }
  .w-70 {
    width: 70%;
  }
  .w-80 {
    width: 80%;
  }
  .w-90 {
    width: 90%;
  }

  .pick {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 12px;
    border: 1px dashed rgb(25 186 31 / 0.7);
    border-radius: 6px;
    background: var(--accent-soft);
  }

  .tag {
    position: absolute;
    top: -10px;
    left: 10px;
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }

  .side {
    flex: none;
    width: 46%;
    padding: 16px 14px;
    border-left: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.8;
  }

  .side-head {
    display: inline-block;
    padding-bottom: 10px;
    color: var(--fg);
    border-bottom: 1.5px solid var(--accent);
    margin-bottom: 12px;
  }

  .side-line {
    color: var(--fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .side-line.typed {
    color: var(--fg-dim);
    white-space: normal;
  }

  .caret {
    display: inline-block;
    width: 6px;
    height: 12px;
    vertical-align: -2px;
    margin-left: 2px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
