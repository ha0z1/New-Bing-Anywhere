---
import Icon from './Icon.astro'

interface Props {
  message: string
  dismissLabel: string
  home: string
}

const { message, dismissLabel, home } = Astro.props
---

<aside class="referral-error" data-referral-error role="alert" hidden>
  <div class="wrap referral-error-inner">
    <Icon name="circleAlert" size={18} />
    <p>{message}</p>
    <button type="button" data-referral-error-dismiss data-home={home} aria-label={dismissLabel} title={dismissLabel}>
      <Icon name="x" size={18} />
    </button>
  </div>
</aside>

<script is:inline>
  ;(() => {
    const banner = document.querySelector('[data-referral-error]')
    if (!banner || document.documentElement.dataset.invalidInvite !== 'true') return
    banner.hidden = false

    banner.querySelector('[data-referral-error-dismiss]')?.addEventListener('click', (event) => {
      const button = event.currentTarget
      try {
        localStorage.removeItem('aa_ref')
        localStorage.removeItem('aa_ref_at')
      } catch {}
      location.replace(button.dataset.home || '/')
    })
  })()
</script>
