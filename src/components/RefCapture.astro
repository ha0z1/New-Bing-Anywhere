---
import { INVITE_CODE_PATTERN_SOURCE } from '../lib/referral'

/**
 * Keep an invite code across the install flow and GitHub OAuth. localStorage is intentional:
 * `ai-anywhere login` may open a new tab, so sessionStorage would lose the referral between the
 * shared landing page and the eventual account page. The membership island consumes it.
 */
---

<script is:inline define:vars={{ inviteCodePatternSource: INVITE_CODE_PATTERN_SOURCE }}>
  ;(() => {
    const key = 'aa_ref'
    const capturedAtKey = 'aa_ref_at'
    const maxAge = 7 * 24 * 60 * 60 * 1000
    const inviteCodePattern = new RegExp(`^${inviteCodePatternSource}$`)
    const normalizeInviteCode = (value) => {
      const code = value?.trim().toUpperCase() || ''
      return inviteCodePattern.test(code) ? code : ''
    }

    const params = new URLSearchParams(location.search)
    const hasReferralParam = params.has('t') || params.has('ref')
    const raw = params.has('t') ? params.get('t') : params.get('ref')
    const code = normalizeInviteCode(raw)
    const membershipPath = {
      '/': '/dashboard/membership',
      '/ja': '/ja/dashboard/membership',
      '/ja/': '/ja/dashboard/membership',
      '/ko': '/ko/dashboard/membership',
      '/ko/': '/ko/dashboard/membership',
      '/zh-Hant': '/zh-Hant/dashboard/membership',
      '/zh-Hant/': '/zh-Hant/dashboard/membership',
    }[location.pathname]

    if (code) {
      try {
        localStorage.setItem(key, code)
        localStorage.setItem(capturedAtKey, String(Date.now()))
      } catch {
        // The query parameter still reaches Membership when storage is unavailable.
      }

      if (membershipPath) {
        const destination = new URL(location.href)
        destination.pathname = membershipPath
        destination.searchParams.delete('t')
        destination.searchParams.set('ref', code)
        location.replace(destination)
      }
      return
    }

    if (hasReferralParam) {
      if (membershipPath) document.documentElement.dataset.invalidInvite = 'true'
      return
    }

    try {
      const capturedAt = Number(localStorage.getItem(capturedAtKey))
      if (capturedAt && Date.now() - capturedAt > maxAge) {
        localStorage.removeItem(key)
        localStorage.removeItem(capturedAtKey)
      }
    } catch {
      // Storage may be unavailable.
    }
  })()
</script>
