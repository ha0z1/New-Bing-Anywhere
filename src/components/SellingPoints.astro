---
import Icon from './Icon.astro'
import { useCopy, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = useCopy(lang)
const s = c.sells
---

<section class="section sells">
  <div class="wrap">
    <p class="eyebrow">{s.eyebrow}</p>
    <ul class="grid">
      {
        s.items.map((item) => (
          <li>
            <span class="mark">
              <Icon name={item.icon as any} size={19} />
            </span>
            <span class="label">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 44px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 26px 26px;
    background: var(--bg);
  }

  .mark {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgb(25 186 31 / 0.16);
  }

  .label {
    font-size: 15px;
    line-height: 1.4;
    color: var(--fg-dim);
    text-wrap: balance;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
    li {
      padding: 20px 22px;
    }
  }
</style>
