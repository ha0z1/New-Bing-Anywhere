---
import InstallCommand from './InstallCommand.astro'
import Demo from './Demo.astro'
import { CLI_MARKS } from '../lib/clis'

/**
 * Through the build pipeline, not `public/`, so each mark lands in `/_astro/` under a content
 * hash and inherits the `immutable` header the rest of the fingerprinted assets get. Copied
 * verbatim out of `public/` they kept their plain names, and an unhashed file cannot be cached
 * forever — every visit spent a revalidation round trip on an icon that never changes.
 */
const MARK_URLS = import.meta.glob<string>('../marks/*.svg', { eager: true, query: '?url', import: 'default' })
import { useCopy, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = useCopy(lang)
---

<section class="hero">
  {/* Decorative: the marks say what this works with, the copy says it in words. */}
  {/* Decorative: the marks say what this works with, the copy says it in words. */}
  <div class="marks" aria-hidden="true">
    {
      CLI_MARKS.filter((m) => !m.off).map((m, i) => (
        <img
          class:list={['mark', m.from && 'wide']}
          style={`--x:${m.x}%;--y:${m.y}%;--r:${m.r}deg;--d:${9 + i * 1.7}s;--delay:-${i * 1.3}s;--lift:${i % 2 ? -9 : 7}px`}
          src={MARK_URLS[`../marks/${m.id}.svg`]}
          width={m.s}
          height={m.s}
          alt=""
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      ))
    }
  </div>
  <div class="wrap stage">
    <div class="inner">
      <p class="positioning">{c.hero.eyebrow}</p>
      <h1>{c.hero.title}</h1>
      <p class="lede">{c.hero.lede}</p>

      <div class="install">
        <InstallCommand lang={lang} id="install-command-hero" />
      </div>
    </div>
    <Demo lang={lang} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 62px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /**
   * Hand-placed around the two things that must stay clean: the headline column on the left and
   * the demo mock on the right. They live in the margins the layout leaves empty, which is what
   * makes them read as material lying around rather than a logo strip — and why they are below
   * the content in the stacking order, dim, and never in the way of a click.
   */
  .marks {
    position: absolute;
    inset: 0;
    z-index: 0;
    color: var(--accent);
    pointer-events: none;
  }

  /**
   * The static offset rides on the individual `translate`/`rotate` properties so `transform` is
   * left free for the animation — the two compose, and the drift stays a compositor-only job.
   * Each mark gets its own period, phase and direction, so they never fall into step and the
   * scatter keeps looking incidental rather than choreographed.
   */
  .mark {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    rotate: var(--r);
    opacity: 0.72;
    animation: mark-drift var(--d) var(--delay) ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes mark-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, var(--lift), 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark {
      animation: none;
    }
  }

  .stage {
    position: relative;
    z-index: 1;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(340px, 0.78fr) minmax(560px, 1.22fr);
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
    max-width: 1320px;
    min-height: inherit;
    padding-block: 52px 64px;
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .positioning {
    max-width: calc(38ch * var(--measure-scale));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--accent);
  }

  h1 {
    max-width: calc(12ch * var(--measure-scale));
    margin-top: 18px;
    font-size: 3.75rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    text-wrap: balance;
  }

  .lede {
    max-width: calc(42ch * var(--measure-scale));
    margin-top: 24px;
    color: var(--fg-dim);
    font-size: 1rem;
    line-height: 1.62;
  }

  .install {
    width: 100%;
    max-width: 560px;
    margin-top: 30px;
  }

  @media (max-width: 1020px) {
    .hero {
      min-height: auto;
    }

    /* one column: the left gutter is gone, so the marks that lived in it go too */
    .mark.wide {
      display: none;
    }

    .mark {
      opacity: 0.28;
    }

    .stage {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-block: 64px 72px;
    }

    .inner {
      width: min(680px, 100%);
    }
  }

  @media (max-width: 520px) {
    .stage {
      gap: 38px;
      padding-block: 44px 52px;
    }

    h1 {
      margin-top: 14px;
      font-size: 2.8rem;
      line-height: 1.04;
    }

    .lede {
      margin-top: 20px;
    }

    .install {
      margin-top: 24px;
    }
  }

  @media (max-width: 390px) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
