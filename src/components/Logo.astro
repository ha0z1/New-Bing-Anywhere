---
interface Props {
  size?: number
  class?: string
}
const { size = 26, class: className } = Astro.props
---

<svg width={size} height={size} viewBox="0 0 32 32" role="img" aria-hidden="true" focusable="false" class={className}>
  <rect width="32" height="32" rx="8.5" fill="#19ba1f"></rect>
  <path
    d="M9.6 10.4 15.6 16l-6 5.6M18.4 21.6h4.6"
    fill="none"
    stroke="#070907"
    stroke-width="3.1"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
