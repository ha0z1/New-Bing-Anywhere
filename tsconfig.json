{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "worker"],
  "compilerOptions": {
    // Astro's base config points JSX at its own runtime; the .tsx islands need React's.
    // .astro files are compiled by the Astro compiler rather than tsc, so this only
    // affects the islands.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
